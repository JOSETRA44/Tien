<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the colours the *window* needs before Compose draws its first frame.
    Everything else lives in the Compose theme (ui/designsystem/theme/Color.kt).

    This file previously held the new-project template palette (purple_200,
    teal_700 …): seven colours no code referenced, which is what Lint's
    UnusedResources check flagged.
-->
<resources>
    <!-- Matches `Paper` in Color.kt. The theme used @android:color/white, a
         visibly cooler shade than the app's own background, so launching showed
         a brief flash of the wrong colour. -->
    <color name="window_background">#FBFAF7</color>
</resources>
