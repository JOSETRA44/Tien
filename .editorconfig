# ═══════════════════════════════════════════════════════════════════════════
#  Tien — editor configuration
#
#  Read by Android Studio / VS Code *and* by ktlint (which runs inside detekt),
#  so the IDE and the build agree on formatting instead of fighting over it.
# ═══════════════════════════════════════════════════════════════════════════
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_packages_to_use_import_on_demand = unset
# Composables are PascalCase; without this ktlint flags every one of them.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview
# Fights Compose's trailing-lambda style, which the Kotlin style guide endorses.
ktlint_standard_function-signature = disabled
ktlint_standard_argument-list-wrapping = disabled

[*.{c,cpp,h,hpp}]
indent_size = 4

[*.{xml,yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[gradlew]
end_of_line = lf

[*.bat]
end_of_line = crlf
